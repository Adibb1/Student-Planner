# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your own values.
# On Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# 1) Firebase web app config
#    Firebase Console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 2) Push notifications (Web Push key)
#    Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Generate key pair
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# 3) Your site's public address (used for the link inside notifications)
#    Local: http://localhost:3000   Production: https://your-planner.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4) Server-only: Firebase Admin key (needed ONLY for push reminders)
#    Firebase Console → Project settings → Service accounts → Generate new private key
#    Copy the three values from the downloaded JSON file.
#    Keep the quotes around the private key and keep the \n characters as they are.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 5) Server-only: any long random string. Protects /api/cron/reminders.
#    Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
